{
  "name": "@leanscript/runtime",
  "version": "0.2.0",
  "description": "The JavaScript runtime for programs compiled with LeanScript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxdeviant/leanscript.git",
    "directory": "packages/runtime"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.js"
