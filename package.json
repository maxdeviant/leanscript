{
  "name": "leanscript-workspace",
  "private": true,
  "type": "module",
  "imports": {
    "#platform/*": {
      "browser": "./packages/runtime/src/platform/browser/*",
      "node": "./packages/runtime/src/platform/node/*",
      "default": "./packages/runtime/src/platform/browser/*"
    }
  },
  "scripts": {
    "format": "prettier --write packages scripts tests examples/*/vite.config.js",
    "format:check": "prettier --check packages scripts tests examples/*/vite.config.js",
    "lint": "oxlint packages scripts tests examples/*/vite.config.js",
    "lint:fix": "oxlint --fix packages scripts tests examples/*/vite.config.js && prettier --write packages scripts tests examples/*/vite.config.js",
    "test": "node scripts/check-versions.js && node scripts/gen-target-externs.js --check && node tests/run.js",
    "gen-externs": "node scripts/gen-target-externs.js"
  },
  "dependencies": {
    "@leanscript/runtime": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10"
  }
}
