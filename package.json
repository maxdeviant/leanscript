{
  "name": "leanscript",
  "private": true,
  "type": "module",
  "exports": {
    "./runtime": "./src/runtime/index.js",
    "./vite": "./src/vite/plugin.js"
  },
  "imports": {
    "#platform/*": {
      "browser": "./src/runtime/platform/browser/*",
      "node": "./src/runtime/platform/node/*",
      "default": "./src/runtime/platform/browser/*"
    }
  },
  "scripts": {
    "format": "prettier --write src/runtime src/vite scripts tests",
    "format:check": "prettier --check src/runtime src/vite scripts tests",
    "lint": "oxlint src/runtime src/vite scripts tests",
    "lint:fix": "oxlint --fix src/runtime src/vite scripts tests && prettier --write src/runtime src/vite scripts tests",
    "test": "node scripts/gen-target-externs.js --check && node tests/run.js",
    "gen-externs": "node scripts/gen-target-externs.js"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10"
  }
}
